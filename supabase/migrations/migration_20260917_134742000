-- 1) Extend employees with telemetry (same-business maintenance)
alter table public.employees
  add column attendance_pattern jsonb not null default '[]'::jsonb,
  add column peer_sentiment integer not null default 0,
  add column skill_matrix jsonb not null default '[]'::jsonb;

-- 2) Mobility plan (one row per employee)
create table public.mobility_plan (
  id uuid primary key default gen_random_uuid(),
  employee_code text not null unique references public.employees(employee_code) on delete cascade,
  current_competencies jsonb not null default '[]'::jsonb,
  target_role jsonb not null default '{}'::jsonb,
  match_score integer not null default 0,
  skill_delta jsonb not null default '[]'::jsonb,
  roadmap_phases jsonb not null default '[]'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
alter table public.mobility_plan enable row level security;

create policy mobility_plan_select on public.mobility_plan
  for select to authenticated using (true);
create policy mobility_plan_insert on public.mobility_plan
  for insert to authenticated
  with check (exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin'));
create policy mobility_plan_update on public.mobility_plan
  for update to authenticated
  using (exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin'));
create policy mobility_plan_delete on public.mobility_plan
  for delete to authenticated
  using (exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin'));

create trigger mobility_plan_set_updated_at
  before update on public.mobility_plan
  for each row execute function public.set_updated_at();

-- 3) Workflow nodes (Action Center timeline)
create table public.workflow_nodes (
  id uuid primary key default gen_random_uuid(),
  position integer not null,
  title text not null,
  owner text not null,
  created_at timestamptz not null default now()
);
alter table public.workflow_nodes enable row level security;

create policy workflow_nodes_select on public.workflow_nodes
  for select to authenticated using (true);
create policy workflow_nodes_insert on public.workflow_nodes
  for insert to authenticated
  with check (exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin'));
create policy workflow_nodes_update on public.workflow_nodes
  for update to authenticated
  using (exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin'));
create policy workflow_nodes_delete on public.workflow_nodes
  for delete to authenticated
  using (exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin'));

-- 4) Workflows (retention executions; drive the Active Workflows metric)
create table public.workflows (
  id uuid primary key default gen_random_uuid(),
  employee_id uuid not null references public.employees(id) on delete cascade,
  created_by uuid references auth.users(id) on delete set null,
  status text not null default 'in_progress' check (status in ('pending','in_progress','completed')),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
alter table public.workflows enable row level security;

create policy workflows_select on public.workflows
  for select to authenticated using (true);
create policy workflows_insert on public.workflows
  for insert to authenticated
  with check (auth.uid() = created_by);
create policy workflows_update on public.workflows
  for update to authenticated
  using (auth.uid() = created_by or exists (select 1 from public.profiles p where p.id = auth.uid() and p.role = 'admin'));

create trigger workflows_set_updated_at
  before update on public.workflows
  for each row execute function public.set_updated_at();